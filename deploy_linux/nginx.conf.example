# Nginx Reverse Proxy Configuration Template for AWS Lightsail / Linux
# Copy this file to /etc/nginx/sites-available/board-scanner on your Linux server

# 1. Backend REST API Proxy (Port 5000)
server {
    listen 80;
    server_name api.yourdomain.com; # Replace with your Domain or Public Static IP

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# 2. Web Simulator Dashboard Proxy (Port 3000)
server {
    listen 80;
    server_name demo.yourdomain.com; # Replace with your Domain or Public Static IP

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
